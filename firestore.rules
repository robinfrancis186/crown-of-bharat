rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /kingdoms/{uid} {
      function owner() { return request.auth != null && request.auth.uid == uid && request.auth.token.firebase.sign_in_provider == 'google.com'; }
      function valid() {
        let d = request.resource.data;
        return d.keys().hasAll(['schema','revision','kingdom','preferences','online','updatedAt'])
          && d.keys().hasOnly(['schema','revision','kingdom','preferences','online','updatedAt'])
          && d.schema == 1 && d.revision is int
          && d.kingdom is string && d.kingdom.size() > 0 && d.kingdom.size() <= 500000
          && d.preferences is string && d.preferences.size() <= 32000
          && d.online is string && d.online.size() <= 32000
          && d.updatedAt == request.time;
      }
      allow get: if owner();
      allow create: if owner() && valid() && request.resource.data.revision == 1;
      allow update: if owner() && valid() && request.resource.data.revision == resource.data.revision + 1;
      allow delete, list: if false;
    }
  }
}
