{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm --prefix monsoon-kingdoms run test:fast && node monsoon-kingdoms/tools/build-release.mjs",
  "outputDirectory": "monsoon-kingdoms/release/monsoon-kingdoms",
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] }
  ]
}
